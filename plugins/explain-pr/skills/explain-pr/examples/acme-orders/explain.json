  "decisions": [
    {
      "title": "Read-through cache in the service",
      "chose": "caching inside orderService.getOrder",
      "over": "caching in the route or the repository",
      "why": "Keeps the route thin and the repository a plain SQL wrapper; the service decides what is cacheable.",
      "where": [
        "src/services/orderService.js:6-12"
      ]
    },
    {
      "title": "Validation errors carry an HTTP status",
      "chose": "an Error with err.status = 400",
      "over": "a dedicated error class",
      "why": "Lets the route map it to a 400 with one check; other errors go to next().",
      "where": [
        "src/services/orderService.js:15-19",
        "`src/routes/orders.js`"
      ]
    },
    {
      "title": "Fixed 5-minute TTL, no invalidation",
      "chose": "expire after 300 s",
      "over": "deleting the key on writes",
      "why": "Simplest option; `cache.del` exists but nothing calls it yet.",
      "where": [
        "src/cache/redisCache.js:4"
      ]
    }
  ],
