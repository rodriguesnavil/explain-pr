{
  "version": 1,
  "summary": "Order requests now go route → service → repository, and reading an order is served from a 5-minute Redis cache before Postgres is asked.",
  "overview": "The routes stop running SQL themselves. Business rules (the total, the new empty-order check) move into `orderService`, SQL moves into `orderRepository`, and reads are cached in Redis. Redis becomes a new runtime dependency for GET /orders/:id.",
  "kind": "refactor",
  "effort": {
    "score": 2,
    "why": "Six small files; the moving parts are the new layering and the cache."
  },
  "intent": {
    "source": "commit messages",
    "checks": [
      {
        "claim": "Routes now call `orderService`",
        "status": "matches",
        "note": "`src/routes/orders.js` imports only ../services/orderService."
      },
      {
        "claim": "Reads go through a 5-minute Redis cache",
        "status": "matches",
        "note": "`TTL_SECONDS = 300` in `redisCache.js`; only `getOrder` reads the cache."
      },
      {
        "claim": "Empty orders are rejected with 400",
        "status": "matches",
        "note": "Also a body with no items array at all now gets 400; before, it threw on `items.reduce`."
      }
    ]
  },
