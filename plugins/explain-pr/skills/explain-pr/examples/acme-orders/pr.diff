diff --git a/src/services/orderService.js b/src/services/orderService.js
new file mode 100644
index 0000000..5ccdbfd
--- /dev/null
+++ b/src/services/orderService.js
@@ -0,0 +1,24 @@
+const repo = require('../repositories/orderRepository')
+const cache = require('../cache/redisCache')
+
+const key = (id) => `order:${id}`
+
+async function getOrder(id) {
+  const cached = await cache.get(key(id))
+  if (cached) return cached
+  const order = await repo.findById(id)
+  if (order) await cache.set(key(id), order)
+  return order
+}
+
+async function placeOrder({ customerId, items }) {
+  if (!Array.isArray(items) || items.length === 0) {
+    const err = new Error('an order needs at least one item')
+    err.status = 400
+    throw err
+  }
+  const total = items.reduce((sum, i) => sum + i.price * i.qty, 0)
+  return repo.create({ customerId, items, total })
+}
+
+module.exports = { getOrder, placeOrder }
