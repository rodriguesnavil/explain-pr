diff --git a/src/cache/redisCache.js b/src/cache/redisCache.js
new file mode 100644
index 0000000..d31af23
--- /dev/null
+++ b/src/cache/redisCache.js
@@ -0,0 +1,19 @@
+const Redis = require('ioredis')
+
+const redis = new Redis(process.env.REDIS_URL)
+const TTL_SECONDS = 300
+
+async function get(key) {
+  const raw = await redis.get(key)
+  return raw ? JSON.parse(raw) : null
+}
+
+async function set(key, value) {
+  await redis.set(key, JSON.stringify(value), 'EX', TTL_SECONDS)
+}
+
+async function del(key) {
+  await redis.del(key)
+}
+
+module.exports = { get, set, del }
diff --git a/src/repositories/orderRepository.js b/src/repositories/orderRepository.js
new file mode 100644
index 0000000..98e724c
--- /dev/null
+++ b/src/repositories/orderRepository.js
@@ -0,0 +1,16 @@
+const db = require('../db')
+
+async function findById(id) {
+  const { rows } = await db.query('SELECT * FROM orders WHERE id = $1', [id])
+  return rows[0] || null
+}
+
+async function create({ customerId, items, total }) {
+  const { rows } = await db.query(
+    'INSERT INTO orders (customer_id, items, total) VALUES ($1, $2, $3) RETURNING *',
+    [customerId, JSON.stringify(items), total]
+  )
+  return rows[0]
+}
+
+module.exports = { findById, create }
