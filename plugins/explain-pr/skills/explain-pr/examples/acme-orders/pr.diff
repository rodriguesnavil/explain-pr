--- /dev/null
+++ b/test/orderService.test.js
@@ -0,0 +1,17 @@
+const assert = require('node:assert')
+const { test, mock } = require('node:test')
+
+test('getOrder returns the cached order without touching the repository', async () => {
+  const cache = require('../src/cache/redisCache')
+  const repo = require('../src/repositories/orderRepository')
+  mock.method(cache, 'get', async () => ({ id: 1 }))
+  const find = mock.method(repo, 'findById', async () => null)
+  const { getOrder } = require('../src/services/orderService')
+  assert.deepStrictEqual(await getOrder(1), { id: 1 })
+  assert.strictEqual(find.mock.callCount(), 0)
+})
+
+test('placeOrder rejects an empty order', async () => {
+  const { placeOrder } = require('../src/services/orderService')
+  await assert.rejects(placeOrder({ customerId: 1, items: [] }), /at least one item/)
+})
